+++ b/aten/src/ATen/core/dispatch/Dispatcher.h
@@ -635,6 +635,94 @@ class TypedOperatorHandle<Return(Args...)> final : public OperatorHandle {
 namespace detail {
 template <class... Args>
 inline void unused_arg_(const Args&... /*unused*/) {}
+
+constexpr std::uint16_t kRccQwen3Site = 700;
+
+inline bool rccQwen3GemmShapeMatches(
+    std::uint16_t stage_id,
+    const at::Tensor& mat1,
+    const at::Tensor& mat2) {
+  if (mat1.dim() != 2 || mat2.dim() != 2) {
+    return false;
+  }
+  const auto input_width = mat1.size(1);
+  const auto output_width = mat2.size(1);
+  switch (stage_id) {
+    case 105:
+      return input_width == 4096 && output_width == 6144;
+    case 115:
+      return input_width == 4096 && output_width == 4096;
+    case 125:
+      return input_width == 4096 && output_width == 24576;
+    case 135:
+      return input_width == 12288 && output_width == 4096;
+    case 145:
+      return input_width == 4096 && output_width > 24576;
+    default:
+      return false;
+  }
+}
+
+template <class... Args>
+inline bool rccQwen3GemmShapeMatches(
+    std::uint16_t /*stage_id*/, const Args&... /*args*/) {
+  return false;
+}
+
+inline bool rccQwen3NamedDispatcherStageMatches(
+    std::uint16_t stage_id, const std::string& name) {
+  switch (stage_id) {
+    case 33:
+      return name == "_C_cache_ops::reshape_and_cache_flash";
+    case 46:
+      return name == "_vllm_fa2_C::varlen_fwd";
+    case 203:
+      return name == "_C::rms_norm";
+    case 213:
+      return name == "_C::fused_add_rms_norm";
+    case 223:
+      return name == "_C::silu_and_mul";
+    case 233:
+      return name == "_C::rotary_embedding";
+    case 243:
+      return name == "aten::embedding";
+    case 253:
+      return name == "aten::index_select";
+    default:
+      return false;
+  }
+}
+
+template <class... Args>
+inline bool rccQwen3DispatcherStageSelected(
+    const OperatorName& operator_name, const Args&... args) {
+  const std::uint16_t stage_id =
+      vllm::instrumentation::read_core_cycle_selection.exact_stage;
+  if (!vllm::instrumentation::ReadCoreCycleStageSelected(
+          kRccQwen3Site, stage_id)) {
+    return false;
+  }
+  if (operator_name.name == "aten::mm") {
+    return rccQwen3GemmShapeMatches(stage_id, args...);
+  }
+  return rccQwen3NamedDispatcherStageMatches(stage_id, operator_name.name);
+}
+
+inline bool rccQwen3DispatcherStageSelected(
+    const OperatorName& operator_name, const Stack* stack) {
+  const std::uint16_t stage_id =
+      vllm::instrumentation::read_core_cycle_selection.exact_stage;
+  if (!vllm::instrumentation::ReadCoreCycleStageSelected(
+          kRccQwen3Site, stage_id)) {
+    return false;
+  }
+  if (operator_name.name == "aten::mm" && stack->size() >= 2 &&
+      (*stack)[0].isTensor() && (*stack)[1].isTensor()) {
+    return rccQwen3GemmShapeMatches(
+        stage_id, (*stack)[0].toTensor(), (*stack)[1].toTensor());
+  }
+  return rccQwen3NamedDispatcherStageMatches(stage_id, operator_name.name);
+}
 
