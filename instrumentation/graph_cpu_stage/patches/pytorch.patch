+inline bool rccQwen3NestedOperatorMatches(
+    std::uint16_t stage, const OperatorName& operator_name) {
+  const auto target = rccQwen3NestedTarget(stage);
+  if (target.name == nullptr ||
+      target.parent != rcc_qwen3_parent_state.parent ||
+      operator_name.name != target.name) {
+    return false;
+  }
+  ++rcc_qwen3_parent_state.target_occurrence;
+  return rcc_qwen3_parent_state.target_occurrence == target.occurrence;
+}
+
+inline bool rccQwen3GemmShapeMatches(
+    std::uint16_t stage,
+    const at::Tensor& mat1,
+    const at::Tensor& mat2) {
+  if (mat1.dim() != 2 || mat2.dim() != 2) {
+    return false;
+  }
+  const auto input_width = mat1.size(1);
+  const auto output_width = mat2.size(1);
+  if (input_width == 4096 && output_width == 6144) {
+    ++rcc_qwen3_qkv_occurrence;
+    return (stage == 1001 && rcc_qwen3_qkv_occurrence == 1) ||
+        (stage == 1066 && rcc_qwen3_qkv_occurrence > 1);
+  }
+  return (stage == 1060 && input_width == 4096 && output_width == 4096) ||
+      (stage == 1062 && input_width == 4096 && output_width == 24576) ||
+      (stage == 1064 && input_width == 12288 && output_width == 4096);
+}
+
+template <class... Args>
+inline bool rccQwen3GemmShapeMatches(
+    std::uint16_t /*stage*/, const Args&... /*args*/) {
+  return false;
+}
+
+inline bool rccQwen3ParentOperatorMatches(
+    std::uint16_t stage, const OperatorName& operator_name) {
+  return (stage == 1005 &&
+          operator_name.name == "vllm::unified_kv_cache_update") ||
+      (stage == 1017 &&
+       operator_name.name == "vllm::unified_attention_with_output");
+}
+
+template <class... Args>
+inline bool rccQwen3OperatorStageMatches(
+    const OperatorName& operator_name, const Args&... args) {
+  if (!vllm::instrumentation::ReadCoreCycleSiteSelected(700)) {
+    return false;
+  }
+  const auto exact_stage =
+      vllm::instrumentation::read_core_cycle_selection.exact_stage;
+  const auto stage =
+      vllm::instrumentation::ReadCoreCycleQwen3PhysicalRoot(exact_stage);
+  if (operator_name.name == "aten::mm" &&
+      (stage == 1001 || stage == 1060 || stage == 1062 ||
+       stage == 1064 || stage == 1066)) {
+    return rccQwen3GemmShapeMatches(stage, args...);
+  }
+  return rccQwen3ParentOperatorMatches(stage, operator_name) ||
+      rccQwen3NestedOperatorMatches(stage, operator_name);
+}
+
+inline bool rccQwen3OperatorStageMatches(
+    const OperatorName& operator_name, const Stack* stack) {
+  if (!vllm::instrumentation::ReadCoreCycleSiteSelected(700)) {
+    return false;
+  }
+  const auto exact_stage =
+      vllm::instrumentation::read_core_cycle_selection.exact_stage;
+  const auto stage =
+      vllm::instrumentation::ReadCoreCycleQwen3PhysicalRoot(exact_stage);
+  if (operator_name.name == "aten::mm" && stack->size() >= 2 &&
+      (*stack)[0].isTensor() && (*stack)[1].isTensor() &&
+      (stage == 1001 || stage == 1060 || stage == 1062 ||
+       stage == 1064 || stage == 1066)) {
+    return rccQwen3GemmShapeMatches(
+        stage, (*stack)[0].toTensor(), (*stack)[1].toTensor());
+  }
+  return rccQwen3ParentOperatorMatches(stage, operator_name) ||
+      rccQwen3NestedOperatorMatches(stage, operator_name);
+}
+
+inline void rccQwen3PublishOperatorBegin(bool selected) {
+  rcc_qwen3_pending_operator_match = selected;
+  if (selected &&
+      !vllm::instrumentation::ReadCoreCycleQwen3FineStage(
+          vllm::instrumentation::read_core_cycle_selection.exact_stage)) {
+    vllm::instrumentation::PublishReadCoreCycleFrontendBegin(
+        700,
+        vllm::instrumentation::read_core_cycle_selection.exact_stage);
+  }
+}
+
+inline bool rccQwen3ConsumePendingOperatorMatch() {
+  const bool selected = rcc_qwen3_pending_operator_match;
+  rcc_qwen3_pending_operator_match = false;
+  return selected;
+}
