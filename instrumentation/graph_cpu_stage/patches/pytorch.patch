+class RccQwen3ParentScope final {
+ public:
+  explicit RccQwen3ParentScope(const OperatorName& operator_name) {
+    if (!vllm::instrumentation::ReadCoreCycleSiteSelected(700) ||
+        rcc_qwen3_parent_state.parent != RccQwen3Parent::None) {
+      return;
+    }
+    const auto stage = vllm::instrumentation::ReadCoreCycleQwen3PhysicalRoot(
+        vllm::instrumentation::read_core_cycle_selection.exact_stage);
+    if (stage >= 1005 && stage <= 1016 &&
+        operator_name.name == "vllm::unified_kv_cache_update") {
+      previous_ = rcc_qwen3_parent_state;
+      rcc_qwen3_parent_state = {
+          RccQwen3Parent::KvCacheUpdate, 0};
+      active_ = true;
+    } else if (stage >= 1017 && stage <= 1059 &&
+               operator_name.name ==
+                   "vllm::unified_attention_with_output") {
+      previous_ = rcc_qwen3_parent_state;
+      rcc_qwen3_parent_state = {RccQwen3Parent::Attention, 0};
+      active_ = true;
+    }
+  }
+
+  ~RccQwen3ParentScope() {
+    if (active_) {
+      rcc_qwen3_parent_state = previous_;
+    }
+  }
+
+ private:
+  RccQwen3ParentState previous_{};
+  bool active_{false};
+};
